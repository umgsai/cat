<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://www.mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dianping.cat.core.mybatis.alert.dao.AlertMapper">
    <resultMap id="BaseResultMap" type="com.dianping.cat.core.mybatis.alert.dao.data.AlertDO">
        <result column="id" property="id"/>
        <result column="domain" property="domain"/>
        <result column="alert_time" property="alertTime"/>
        <result column="category" property="category"/>
        <result column="type" property="type"/>
        <result column="content" property="content"/>
        <result column="metric" property="metric"/>
        <result column="creation_date" property="creationDate"/>
    </resultMap>

    <sql id="Base_Column_List">
        id ,
        domain ,
        alert_time ,
        category ,
        type ,
        content ,
        metric ,
        creation_date
    </sql>

    <sql id="setField">
        <set>
            <if test="id != null">id = #{id} ,</if>
            <if test="domain != null">domain = #{domain} ,</if>
            <if test="alertTime != null">alert_time = #{alertTime} ,</if>
            <if test="category != null">category = #{category} ,</if>
            <if test="type != null">type = #{type} ,</if>
            <if test="content != null">content = #{content} ,</if>
            <if test="metric != null">metric = #{metric} ,</if>
            <if test="creationDate != null">creation_date = #{creationDate}</if>
        </set>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyColumn="id"
            parameterType="com.dianping.cat.core.mybatis.alert.dao.data.AlertDO" keyProperty="id">
        INSERT INTO alert
        <include refid="setField"/>
    </insert>

    <select id="findByPrimaryKey" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from alert where id = #{id}
    </select>

    <select id="queryAll" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from alert
    </select>

    <delete id="deleteByPrimaryKey">
        delete from alert where id = #{id}
    </delete>

    <update id="updateByPrimaryKey" parameterType="com.dianping.cat.core.mybatis.alert.dao.data.AlertDO">
        UPDATE alert
        <include refid="setField"/>
        WHERE id = #{id}
    </update>

    <select id="queryAlertsByTimeDomain" resultMap="BaseResultMap">
        select id, domain, alert_time, category, type, content, metric, creation_date from alert where alert_time >= #{record.startTime} and alert_time &lt;= #{record.endTime} <if test="record.domain != null"> and domain = #{record.domain} </if> order by alert_time desc
    </select>

    <select id="queryAlertsByTimeDomainCategories" resultMap="BaseResultMap">
        select id, domain, alert_time, category, type, content, metric, creation_date from alert where alert_time >= #{record.startTime} and alert_time &lt;= #{record.endTime} <if test="record.domain != null"> and domain = #{record.domain} </if> and category in <foreach collection="record.categories" item="item" open="(" close=")" separator=",">#{item}</foreach> order by alert_time desc
    </select>

    <select id="queryAlertsByTimeCategoryDomain" resultMap="BaseResultMap">
        select id, domain, alert_time, category, type, content, metric, creation_date from alert where alert_time >= #{record.startTime} and alert_time &lt;= #{record.endTime} <if test="record.category != null"> and category = #{record.category} </if> <if test="record.domain != null"> and domain = #{record.domain} </if> order by alert_time asc
    </select>

    <select id="queryAlertsByTimeCategory" resultMap="BaseResultMap">
        select id, domain, alert_time, category, type, content, metric, creation_date from alert where alert_time >= #{record.startTime} and alert_time &lt;= #{record.endTime} <if test="record.category != null"> and category = #{record.category} </if> order by alert_time asc
    </select>

</mapper>