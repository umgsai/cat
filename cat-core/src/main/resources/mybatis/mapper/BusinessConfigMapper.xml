<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://www.mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dianping.cat.core.mybatis.mapper.BusinessConfigMapper">
    <resultMap id="BaseResultMap" type="com.dianping.cat.core.mybatis.data.BusinessConfigDO">
        <result column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="domain" property="domain"/>
        <result column="content" property="content"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id ,
        name ,
        domain ,
        content ,
        create_time ,
        update_time
    </sql>

    <sql id="setField">
        <set>
            <if test="id != null">id = #{id} ,</if>
            <if test="name != null">name = #{name} ,</if>
            <if test="domain != null">domain = #{domain} ,</if>
            <if test="content != null">content = #{content} ,</if>
            <if test="createTime != null">create_time = #{createTime} ,</if>
            <if test="updateTime != null">update_time = #{updateTime}</if>
        </set>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyColumn="id"
            parameterType="com.dianping.cat.core.mybatis.data.BusinessConfigDO" keyProperty="id">
        INSERT INTO t_business_config
        <include refid="setField"/>
    </insert>

    <select id="findByPrimaryKey" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_business_config where id = #{id}
    </select>

    <select id="queryAll" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_business_config
    </select>

    <delete id="deleteByPrimaryKey">
        delete from t_business_config where id = #{id}
    </delete>

    <update id="updateByPrimaryKey" parameterType="com.dianping.cat.core.mybatis.data.BusinessConfigDO">
        UPDATE t_business_config
        <include refid="setField"/>
        WHERE id = #{id}
    </update>

    <select id="findByNameDomain" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_business_config where name = #{record.name} and domain = #{record.domain}
    </select>

    <select id="findByName" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_business_config where name = #{record.name}
    </select>

    <update id="updateBaseConfigByDomain">
        UPDATE t_business_config SET content=#{record.content}, update_time=NOW() where domain = #{record.domain} and name = #{record.name}
    </update>

</mapper>
