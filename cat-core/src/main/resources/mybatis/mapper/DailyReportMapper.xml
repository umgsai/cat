<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://www.mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dianping.cat.core.report.daily.dao.DailyReportMapper">
    <resultMap id="BaseResultMap" type="com.dianping.cat.core.report.daily.dao.data.DailyReportDO">
        <result column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="ip" property="ip"/>
        <result column="domain" property="domain"/>
        <result column="period" property="period"/>
        <result column="type" property="type"/>
        <result column="creation_date" property="creationDate"/>
    </resultMap>

    <sql id="Base_Column_List">
        id ,
        name ,
        ip ,
        domain ,
        period ,
        type ,
        creation_date
    </sql>

    <sql id="setField">
        <set>
            <if test="id != null">id = #{id} ,</if>
            <if test="name != null">name = #{name} ,</if>
            <if test="ip != null">ip = #{ip} ,</if>
            <if test="domain != null">domain = #{domain} ,</if>
            <if test="period != null">period = #{period} ,</if>
            <if test="type != null">type = #{type} ,</if>
            <if test="creationDate != null">creation_date = #{creationDate}</if>
        </set>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyColumn="id"
            parameterType="com.dianping.cat.core.report.daily.dao.data.DailyReportDO" keyProperty="id">
        INSERT INTO dailyreport
        <include refid="setField"/>
    </insert>

    <select id="findById" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from dailyreport where id = #{id}
    </select>

    <select id="findByDomainNamePeriod" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from dailyreport
        where period = #{period}
        and domain = #{domain}
        and name = #{name}
        and BINARY(domain) = BINARY(#{domain})
    </select>

    <select id="queryLatestReportsByDomainName" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from dailyreport
        where domain = #{domain}
        and name = #{name}
        and BINARY(domain) = BINARY(#{domain})
        order by id DESC
        limit #{limits}
    </select>

    <delete id="deleteById">
        delete from dailyreport where id = #{id}
    </delete>

    <delete id="deleteByDomainNamePeriod">
        DELETE from dailyreport
        where period = #{period}
        and domain = #{domain}
        and name = #{name}
        and BINARY(domain) = BINARY(#{domain})
    </delete>

    <update id="updateById" parameterType="com.dianping.cat.core.report.daily.dao.data.DailyReportDO">
        UPDATE dailyreport
        <include refid="setField"/>
        WHERE id = #{id}
    </update>

</mapper>